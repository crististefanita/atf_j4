<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>atf.api</groupId><artifactId>atf</artifactId><version>1.0.0-SNAPSHOT</version></parent>
    <artifactId>atf-test-android</artifactId>
    <name>ATF Android infrastructure and acceptance</name>
    <description>Bounded ADB, captured Android data and application acceptance contracts</description>
    <dependencies>
        <dependency><groupId>atf.api</groupId><artifactId>atf-core</artifactId><version>${atf.core.version}</version></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-reporting</artifactId><version>${atf.reporting.version}</version></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-test-kit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-console</artifactId><version>${atf.console.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.2</version>
        <executions><execution><id>independent-whist-player</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
            <configuration><sources><source>${project.basedir}/../whist-lab-app/ai-lab/src/main/java</source><source>${project.basedir}/../whist-lab-app/game-core/src/main/java</source></sources></configuration>
        </execution></executions>
    </plugin></plugins></build>
    <profiles>
        <profile>
            <id>display-components</id>
            <build><plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
                    <executions><execution><id>independent-whist-player</id>
                        <configuration><skipAddTestSource>true</skipAddTestSource></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                    <configuration><testIncludes>
                        <testInclude>**/AndroidDisplayComponentSuite.java</testInclude>
                        <testInclude>**/display/component/*.java</testInclude>
                        <testInclude>**/display/profile/*ComponentTest.java</testInclude>
                        <testInclude>**/display/HandGeometryDriverComponentTest.java</testInclude>
                        <testInclude>**/e2e/driver/*.java</testInclude>
                    </testIncludes></configuration>
                </plugin>
            </plugins></build>
        </profile>
        <profile>
            <id>responsive-sanity</id>
            <build><plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
                    <executions><execution><id>independent-whist-player</id>
                        <configuration><skipAddTestSource>true</skipAddTestSource></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                    <configuration><testIncludes>
                        <testInclude>**/AndroidUiDriver.java</testInclude>
                        <testInclude>**/AndroidDisplayComponentSuite.java</testInclude>
                        <testInclude>**/display/component/*.java</testInclude>
                        <testInclude>**/display/profile/*ComponentTest.java</testInclude>
                        <testInclude>**/display/HandGeometryDriverComponentTest.java</testInclude>
                        <testInclude>**/ResponsiveDisplayProfile.java</testInclude>
                        <testInclude>**/AndroidUiDriverComponentTest.java</testInclude>
                        <testInclude>**/ResponsiveDisplayProfileComponentTest.java</testInclude>
                        <testInclude>**/FrameFillAuditComponentTest.java</testInclude>
                        <testInclude>**/TableViewportAuditComponentTest.java</testInclude>
                        <testInclude>**/DisplayRasterComponentTest.java</testInclude>
                        <testInclude>**/display/flow/responsive/*.java</testInclude>
                        <testInclude>**/AndroidUiFlowReportPublisherTest.java</testInclude>
                        <testInclude>**/WhistResponsivePlaySanityE2eTest.java</testInclude>
                        <testInclude>**/WhistDenseLayoutE2eTest.java</testInclude>
                    </testIncludes></configuration>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>

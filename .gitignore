# Output local Maven/JVM; nu face parte din sursa ATF.
target/
.locks/
*.class
artifacts/
**/.gradle/
**/build/
local.properties
.presentation-build/
_mmdc-config.json
_render_*.mmd
_render_*.png
hs_err_pid*.log
reports/
.speech-cache/
models/
.venv/
__pycache__/
*.pyc

# IDE-uri și fișiere locale.
.idea/
*.iml
.classpath
.project
.settings/

# Păstrăm numai dosarul livrării active; rulările intermediare sunt externe.
!/release/
!/release/**

# APK-ul și checksum-ul local însoțesc versiunea; distribuția este în GitHub Releases.
/release/**/*.apk
/release/**/*.apk.sha256

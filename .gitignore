# Output local Maven/JVM; nu face parte din sursa ATF.
target/
artifacts/
**/.gradle/
**/build/
local.properties
.presentation-build/
_mmdc-config.json
_render_*.mmd
_render_*.png
hs_err_pid*.log
reports/
.speech-cache/
models/
.venv/
__pycache__/
*.pyc

# APK-urile de livrare rămân local; distribuția versionată este în GitHub Releases.
/dist/*.apk
/dist/*.apk.sha256

# IDE-uri și fișiere locale.
.idea/
*.iml
.classpath
.project
.settings/

# Keep registered, versioned release evidence; intermediate runs stay external.
!artifacts/
/artifacts/*
!/artifacts/README.md
!/artifacts/index.json
!/artifacts/[0-9]*/
!/artifacts/[0-9]*/**

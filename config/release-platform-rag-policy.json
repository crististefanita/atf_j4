{
  "schemaVersion": 1,
  "evidenceStatuses": [
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT_RUN",
    "NOT_APPLICABLE",
    "NOT_IMPLEMENTED"
  ],
  "sharedGates": [
    "sourceSnapshot",
    "gameCoreComponents"
  ],
  "candidateLifecycle": {
    "states": [
      "TEMP_SOURCE_PINNED",
      "TEMP_QUALIFIED",
      "READY_FOR_HUMAN_REVIEW",
      "PROMOTED_TO_MAIN",
      "PUBLISHED"
    ],
    "candidateArtifactsOutsideCheckoutUntilPromotion": true,
    "promotionRequires": [
      "aggregateStatus=READY_FOR_HUMAN_REVIEW",
      "mainTreeSha256EqualsQualifiedSnapshotSha256"
    ],
    "publicationRequires": [
      "promotedCommitMatchesQualifiedSnapshot",
      "publishedApkSha256EqualsQualifiedApkSha256",
      "downloadReceiptMatchesDeclaredAccessModeAndApkSha256"
    ],
    "ragMayAdvanceLifecycle": false,
    "ragOutputOutsideCheckout": true
  },
  "ragEvaluator": {
    "entrypoint": "atf-tests/tools/evaluate-release-rag.mjs",
    "runtime": "Node.js standard library",
    "readOnlyInputs": ["release-validation.json", "release payload", "source input manifest", "pinned source files", "candidate plan", "policy"],
    "outputSchema": "ATF_RELEASE_RAG_VERDICT",
    "outputMustBeOutsideInputs": true,
    "citationsRequire": ["path", "sha256", "jsonPointerAndLineForJson"],
    "publicReadmeSurface": {
      "path": "README.md",
      "forbidRawSha256Digest": true
    },
    "sourceVerification": "every listed source file plus exact input-manifest fingerprint",
    "requiredComponentGroup": "atf-tests",
    "requiredComponentGroupsByPlatform": {
      "android": [
        "atf-validation",
        "atf-test-android",
        "atf-tests",
        "whist-lab-app-bidding",
        "whist-lab-app-commands",
        "whist-lab-app-display",
        "whist-lab-app-history"
      ]
    },
    "introducedComponentGroupsByPlatform": {
      "android": [
        {
          "group": "whist-lab-app-achievements",
          "sinceReleaseVersion": "0.18.0"
        },
        {
          "group": "whist-lab-app-atf-card-table-ui",
          "sinceReleaseVersion": "0.20.2"
        }
      ]
    },
    "platformGates": {
      "androidBeforeHumanReview": ["androidComponents", "apkBuild", "apkIdentity", "signing"],
      "androidAfterPublication": ["distributionDownload"],
      "gateReceiptShape": {"status": "PASS", "receipt": "payload-relative path"},
      "gateReceiptMustBeHashBound": true
    },
    "componentSourceBinding": {
      "inputManifest": "reports/component/source-inputs.json",
      "runReceipt": "reports/component/source-component-run.json",
      "provenanceReceipt": "reports/component/source-provenance.json",
      "executionReceiptPattern": "reports/component/{group}/execution.json",
      "historicalReuseRequiresUnchangedSuiteInputs": true,
      "eachExtentMustMatchExecutionReceipt": true,
      "eachReceiptMustBindItsOriginalSourceFingerprint": true
    },
    "onlyHumanReviewVerdict": "READY_FOR_HUMAN_REVIEW",
    "doesNotInspectGitIndexOrExecuteGit": true,
    "doesNotPerformPromotionOrPublication": true,
    "e2e": {
      "decisionMustBeExplicit": true,
      "notRunNeverMeansPass": true,
      "changedUserFlowRequiresPass": true,
      "frozenUnchangedUserFlowMayRemainNotRunWithRationale": true,
      "executionReceiptPattern": "reports/e2e/{suite}/execution.json",
      "receiptMustMatchManifestReleaseAndSource": true,
      "receiptMustMatchExtentHashAndOutcomes": true,
      "inlinePngCountMustMatchExtent": true,
      "reportPathsUniqueAcrossScopes": true
    }
  },
  "suiteQualification": {
    "scopeComesFromChangedContractsAndRisk": true,
    "versionLabelMayReduceRequiredCoverage": false,
    "profiles": {
      "maintenanceOrRefactor": ["affectedUnitOrComponent", "documentationAndGovernance"],
      "behaviorChange": ["affectedUnitOrComponent", "documentationAndGovernance", "targetedE2eWhenUserFlowChanges"],
      "structuralOrReleaseChange": ["broadUnitAndComponent", "documentationAndGovernance", "riskSelectedE2e", "releaseArtifactAndDownload"]
    },
    "e2eNotSelectedRequiresRiskRationale": true,
    "currentApplicationE2eMayBeFrozenWhenNoUserFlowChanges": true
  },
  "reportingContract": {
    "owner": "atf-reporting",
    "renderer": "Extent",
    "oneCanonicalHtmlPerExecutedSuiteSelection": true,
    "componentReportPathPattern": "reports/component/{group}/component-report.html",
    "e2eReportPathPattern": "reports/e2e/{suite}/report.html",
    "eachSuiteOwnsUniqueReportPath": true,
    "everyExecutedSuiteRequiresInlinePngEvidence": true,
    "componentAndE2eScopesRemainDistinct": true,
    "exactJUnitIdentityAndOutcomeParity": true,
    "junitXmlRole": "temporary-independent-oracle",
    "duplicateJUnitXmlInFinalRelease": false,
    "capturedImagesMustBeInlineBase64": true,
    "reportBindsQualifiedSourceSnapshot": true
  },
  "signingChannels": {
    "channelMustBeDeclared": true,
    "testDistributionMayUseDebugCertificate": true,
    "productionDistributionRequiresManagedKey": true,
    "allChannelsRequireCertificateFingerprintAndUpgradeCompatibility": true
  },
  "platforms": {
    "android": {
      "artifactKinds": ["apk"],
      "requiredGates": [
        "androidComponents",
        "apkBuild",
        "apkIdentity",
        "signing",
        "distributionDownload"
      ]
    },
    "ios": {
      "artifactKinds": ["ipa", "xcarchive"],
      "requiredGates": [
        "iosBridgeComponents",
        "xcodeSimulator",
        "iosArtifactIdentity",
        "signing",
        "iosDistribution"
      ]
    }
  },
  "rules": {
    "legacyApkManifestPlatforms": ["android"],
    "androidEvidenceSatisfiesIos": false,
    "catalogMustMatchManifestAndPublicLinks": true,
    "readyRequiresEveryDeclaredPlatform": true,
    "distributionAccessModes": ["AUTHENTICATED", "ANONYMOUS"],
    "authenticatedDownloadChannels": {
      "GitHub API authenticated": "HTTP_200",
      "Browser MCP authenticated": "COMPLETED_DOWNLOAD"
    },
    "authenticatedDownloadReceiptMustOmitCredentials": true,
    "allowedAggregateStatuses": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"],
    "ragMayExecuteCommands": false,
    "ragMayBuildOrSign": false,
    "ragMayPublish": false,
    "ragMayInferPassFromDocumentation": false
  }
}
